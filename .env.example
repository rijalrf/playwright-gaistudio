# =================================================================
# Google AI Studio TTS Playwright - Environment Configuration
# =================================================================

# Port HTTP API Server (Default Suite: 3740)
PORT=3740

# Secret API Key untuk autentikasi endpoint REST API
# Sertakan via header "X-API-Key", "Authorization: Bearer <key>", atau query "?key=" / "?api_key="
API_KEY=your-secret-api-key-here

# Tampilkan jendela Chrome AI Studio di layar (false = terlihat, true = disembunyikan di luar layar).
# Set false saat memantau/mendiagnosis proses generate.
OFFSCREEN=true

# Sesi browser dipakai ulang antar job; tutup otomatis setelah idle selama ini (ms).
SESSION_IDLE_MS=120000

# Daur ulang halaman AI Studio setiap N job.
MAX_JOBS_PER_SESSION=25

# Batas tunggu event download / blob audio per percobaan (ms).
DOWNLOAD_TIMEOUT_MS=12000

# true = buka browser + AI Studio saat service start.
PREWARM_BROWSER=false

